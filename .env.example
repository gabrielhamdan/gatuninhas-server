# Copie este arquivo para ".env" (que fica fora do git) e ajuste se precisar.
# .env NAO deve ser commitado - garanta que esta no .gitignore.

POSTGRES_DB=gatuninhas
POSTGRES_USER=gatuninhas
POSTGRES_PASSWORD=gatuninhas
POSTGRES_PORT=5432

SERVER_PORT=8080

# Gere valores fortes e DIFERENTES para access e refresh, por exemplo com:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=troque-para-um-segredo-forte-e-aleatorio-de-access
JWT_REFRESH_SECRET=troque-para-um-segredo-forte-e-aleatorio-de-refresh

JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
